# ==============================================================================
# Variables de entorno para Peluchitos Bonbin Backend
# Copiar este archivo a .env y completar los valores reales
# ==============================================================================

# Amazon RDS MySQL
DB_HOST=tu-rds-endpoint.us-east-1.rds.amazonaws.com
DB_USERNAME=admin
DB_PASSWORD=tu-password-seguro

# AWS Cognito
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
API_AUDIENCE=tu-api-client-id

# RabbitMQ (Valores por defecto para docker compose)
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
